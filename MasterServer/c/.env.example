# Copy to ~/.rysteria-secrets/master.env (scripts/ does this for you) and fill in.
# Never commit the real file. Generate secrets with: openssl rand -hex 32

# postgres | mongo  (more engines: add db_<name>.c and a case in db.c)
DB_TYPE=postgres
POSTGRES_URI=postgresql://user:password@127.0.0.1:5432/rysteria
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=rysteria
DB_POOL_SIZE=4

PORT=55554
# empty = all interfaces; 127.0.0.1 when only cloudflared talks to it
BIND_ADDRESS=127.0.0.1
# browser origins allowed to call the public routes (comma separated, exact)
ALLOWED_ORIGINS=https://game.parshwa.blog
# header carrying the real client address when behind cloudflared
TRUST_PROXY_HEADER=CF-Connecting-IP

# shared with every game server / gardn (X-Server-Secret)
SERVER_SECRET=
# token secrets: rotating them logs everybody out
TOKEN_SECRET_1=
TOKEN_SECRET_2=
OTP_PEPPER=
# the PIN a minigame match must be started with for its wins to count (empty = none count)
MINIGAMES_PIN=

# seconds a PL-P stays valid (default one week)
PL_P_LIFETIME_SECONDS=604800
# how long unsaved player changes may stay in memory
FLUSH_INTERVAL_MS=5000

# run once when a game server drops without saying it is stopping; {name} is its
# name (the deployment scripts set this to scripts/common/restart-one.sh {name})
RESTART_COMMAND=
# 0 = do not check every account against its saves when the master starts
# (the leaderboards are corrected then, see README.md)
LEADERBOARD_VERIFY=1

# seconds it gets to connect again before the master gives up
RESTART_WAIT_SECONDS=90

# where OAuth sends the browser back to (the rrolf client page)
CLIENT_URL=https://game.parshwa.blog/
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=https://api-game.parshwa.blog/oauth/discord/callback

# Sign in with Google (console.cloud.google.com > APIs and services > Credentials >
# OAuth client, type "web". Authorized redirect URI = GOOGLE_REDIRECT_URI). Off while empty
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api-game.parshwa.blog/oauth/google/callback

# Sign in with Apple (developer.apple.com > Identifiers > a Services ID with "Sign in with
# Apple", its return URL = APPLE_REDIRECT_URI, and a Key with that capability: its .p8 file
# and Key ID). Off while any of these is empty
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=
APPLE_REDIRECT_URI=https://api-game.parshwa.blog/oauth/apple/callback

# Email codes (password reset, username change) through an HTTPS email API, see email.c.
# EMAIL_API_AUTH is the header line with the key ({key}), EMAIL_API_BODY the JSON body
# ({from} {to} {subject} {text} are replaced by JSON strings). Off while the first three are empty
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
# EMAIL_API_AUTH=Authorization: Bearer {key}
# EMAIL_API_BODY={"from":{from},"to":{to},"subject":{subject},"text":{text}}
